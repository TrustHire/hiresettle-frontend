# ============================================================
# HireSettle Frontend — Environment Variables
# Copy to .env.local
# ============================================================

NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_USDC_ADDRESS=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Ledger constant — 86400s ÷ 5s per ledger
NEXT_PUBLIC_LEDGERS_PER_DAY=17280

# IPFS gateway for proof preview links (trailing slash optional)
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io

# Backend-proxied IPFS pinning — set these on the server, not the client
# Supported: pinata | web3storage
IPFS_PINNING_SERVICE=pinata
IPFS_PINNING_KEY=your-pinata-jwt-or-web3storage-token
