# ============================================================
# HireSettle Frontend — Environment Variables
# Copy to .env.local
# ============================================================

NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
# Stellar network the app targets: testnet | mainnet
# Drives the network badge in the top bar; any non-mainnet value also shows a
# dismissible "test funds only" warning banner.
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_USDC_ADDRESS=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Classic USDC issuer used for the trustline helper (defaults to Circle's USDC
# issuer for the selected network)
NEXT_PUBLIC_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# Friendbot endpoint for the testnet "Fund with Friendbot" helper (testnet only)
NEXT_PUBLIC_FRIENDBOT_URL=https://friendbot.stellar.org

# Ledger constant — 86400s ÷ 5s per ledger
NEXT_PUBLIC_LEDGERS_PER_DAY=17280

# IPFS gateway for proof preview links (trailing slash optional)
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io

# Backend-proxied IPFS pinning — set these on the server, not the client
# Supported: pinata | web3storage
IPFS_PINNING_SERVICE=pinata
IPFS_PINNING_KEY=your-pinata-jwt-or-web3storage-token
